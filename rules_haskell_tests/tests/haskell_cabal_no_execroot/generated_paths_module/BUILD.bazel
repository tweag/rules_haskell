load("@rules_haskell//haskell:cabal.bzl", "haskell_cabal_library")

package(default_testonly = 1)

# Uses the Paths_ module that rules_haskell generates.
haskell_cabal_library(
    name = "lib",
    package_name = "no-execroot-generated",
    srcs = [
        "Lib.hs",
        "datafile",
        "no-execroot-generated.cabal",
    ],
    generate_paths_module = True,
    tags = ["skip_profiling"],
    version = "0.1.0.0",
    visibility = ["//tests/haskell_cabal_no_execroot:__pkg__"],
    deps = ["@rules_haskell//tools/runfiles"],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

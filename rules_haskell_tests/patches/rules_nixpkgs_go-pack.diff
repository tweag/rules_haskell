+def _rules_go_needs_pack(repository_ctx):
+    """Whether rules_go's go_toolchain has a mandatory `pack` attribute (rules_go >= 0.57.0).
+
+    RULES_GO_VERSION is not reliable for this (it is stuck at 0.50.0), so look for the attribute.
+    See https://github.com/tweag/rules_nixpkgs/issues/667
+    """
+    go_toolchain_bzl = repository_ctx.read(Label("@io_bazel_rules_go//go/private:go_toolchain.bzl"))
+    return '"pack": attr.label(' in go_toolchain_bzl

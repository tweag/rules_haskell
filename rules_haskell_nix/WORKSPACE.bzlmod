load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
load(
    "@rules_nixpkgs_core//:nixpkgs.bzl",
    "nixpkgs_package",
)

nixpkgs_package(
    name = "buildifier",
    attribute_path = "bazel-buildtools",
    build_file_content = """filegroup(name = "buildifier", srcs=["bin/buildifier"], visibility = [ "//visibility:public" ])""",
    repository = "@nixpkgs_default",
)

http_archive(
    name = "com_github_bazelbuild_buildtools",
    sha256 = "5af90068e9e8812abdc455ad04cc474470bccc8bbabc8b571e3f58a66799680f",
    strip_prefix = "buildtools-10.2.0",
    urls = [
        "https://github.com/bazelbuild/buildtools/archive/refs/tags/v10.2.0.tar.gz",
    ],
)

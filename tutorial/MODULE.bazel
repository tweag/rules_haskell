bazel_dep(
    name = "platforms",
    version = "1.1.0",
)

# rules_haskell_nix must come before rules_haskell so that nix
# toolchains are considered first
bazel_dep(
    name = "rules_haskell_nix",
    version = "1.0",
)
bazel_dep(
    name = "rules_haskell",
    version = "1.0",
)
bazel_dep(
    name = "rules_nixpkgs_core",
    version = "0.14.1",
)
archive_override(
    module_name = "rules_nixpkgs_core",
    integrity = "sha256-VAJWiTZyBbg1GYZ35obYIItXC/2E5ocmhK5ld0dnO5c=",
    strip_prefix = "rules_nixpkgs-0.14.1/core",
    urls = ["https://github.com/tweag/rules_nixpkgs/releases/download/v0.14.1/rules_nixpkgs-0.14.1.tar.gz"],
)

# Required by rules_haskell_nix.
archive_override(
    module_name = "rules_nixpkgs_posix",
    integrity = "sha256-VAJWiTZyBbg1GYZ35obYIItXC/2E5ocmhK5ld0dnO5c=",
    strip_prefix = "rules_nixpkgs-0.14.1/toolchains/posix",
    urls = ["https://github.com/tweag/rules_nixpkgs/releases/download/v0.14.1/rules_nixpkgs-0.14.1.tar.gz"],
)
